APP_NAME=Cameroon CS Learning Platform API
APP_ENV=development
PAYMENT_MODE=mock
DEBUG=false
CORS_ORIGINS=http://localhost:5173
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/learning_platform
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_EXPIRE_MINUTES=30

# Optional file storage. Large video uploads use signed direct-to-Cloudinary uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=learning-platform
# Use `dynamic` only if this Cloudinary product environment has Dynamic Folder mode enabled.
CLOUDINARY_FOLDER_MODE=fixed
CLOUDINARY_MAX_IMAGE_SIZE=10485760
CLOUDINARY_MAX_DOCUMENT_SIZE=20971520
CLOUDINARY_MAX_VIDEO_SIZE=524288000

# Optional transactional email
RESEND_API_KEY=
EMAIL_FROM=Learning Platform <noreply@example.com>

# Optional mobile money credentials; real provider adapters require merchant approval/contracts.
MTN_API_BASE_URL=
MTN_API_KEY=
MTN_SUBSCRIPTION_KEY=
ORANGE_API_BASE_URL=
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
